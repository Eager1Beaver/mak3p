{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "core-debug",
      "displayName": "Core / Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/core-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AUDIO_CONVERTER_BUILD_GUI": "OFF",
        "AUDIO_CONVERTER_BUILD_AUDIO": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "audio-debug",
      "inherits": "core-debug",
      "displayName": "Audio / Debug",
      "binaryDir": "${sourceDir}/build/audio-debug",
      "cacheVariables": {
        "AUDIO_CONVERTER_BUILD_AUDIO": "ON"
      }
    },
    {
      "name": "wsl-debug",
      "displayName": "WSL2 / GCC Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wsl-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "wsl-release",
      "displayName": "WSL2 / GCC Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wsl-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows / MSVC portable Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded"
      }
    }
  ],
  "buildPresets": [
    { "name": "audio-debug", "configurePreset": "audio-debug" },
    { "name": "core-debug", "configurePreset": "core-debug" },
    { "name": "wsl-debug", "configurePreset": "wsl-debug" },
    { "name": "wsl-release", "configurePreset": "wsl-release" },
    { "name": "windows-release", "configurePreset": "windows-release" }
  ],
  "testPresets": [
    { "name": "audio-debug", "configurePreset": "audio-debug", "output": { "outputOnFailure": true } },
    { "name": "core-debug", "configurePreset": "core-debug", "output": { "outputOnFailure": true } },
    { "name": "wsl-debug", "configurePreset": "wsl-debug", "output": { "outputOnFailure": true } },
    { "name": "wsl-release", "configurePreset": "wsl-release", "output": { "outputOnFailure": true } }
  ]
}
